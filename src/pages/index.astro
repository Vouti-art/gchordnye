---
import "@picocss/pico/css/pico.classless.min.css";
import InstrumentGuide from "../components/InstrumentGuide.astro";
import Countdown from "../components/Countdown.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={import.meta.env.BASE_URL + "favicon.svg"}
    />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.ico"} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>G Chord NYE</title>
  </head>
  <body>
    <header>
      <h1>G Chord NYE</h1>
      <p>Supporting human musicianship in response to AI-generated music</p>
      <time datetime="2026-12-31">December 31, 2026</time>
      <p>Midnight in your local time zone: when 2026 becomes 2027</p>
    </header>
    <main>
      <section>
        <Countdown />
      </section>
      <section>
        <h2>How to join</h2>
        <ol>
          <li>Prepare your instrument</li>
          <li>Face west</li>
          <li>Play a G chord or G note</li>
        </ol>
        <p>
          If you sing, play percussion, or cannot face west, you are still
          welcome to participate!
        </p>
      </section>
      <InstrumentGuide />
      <section>
        <h2>Record and share</h2>
        <p>
          Recording is optional. The important part is playing. If you want to
          share your performance, record it at your local midnight and post it
          on Instagram when you're ready.
        </p>
        <p>
          Tag <a href="https://instagram.com/quentinlintz">@quentinlintz</a> and add
          {" "}<strong>#gchordnye</strong> so the community can find it!
        </p>
      </section>
      <section>
        <h2>Join the Midnight Chord Club</h2>
        <p>
          Join more than 800 people in the Midnight Chord Club, a Discord
          community dedicated to G Chord NYE.
        </p>
        <p>
          <a href="https://discord.gg/KN6VYYny6s"
            >Join the Midnight Chord Club on Discord</a
          >
        </p>
      </section>
    </main>
    <footer>
      This site was <a href="https://github.com/quentinlintz/gchordnye"
        >coded by hand</a
      >, by a human
    </footer>
  </body>
</html>
